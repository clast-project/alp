<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Clast.Alp</AssemblyName>
    <RootNamespace>Clast.Alp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Clast.Alp</PackageId>
    <!-- Default for local builds; release.yml overrides via -p:Version=<tag>. -->
    <Version>0.0.0-dev</Version>
    <!-- Held across the whole 0.2.x line so consumers don't need a binding
         redirect per patch. Under 0.x semver the minor is the breaking slot,
         so bump this to 0.3.0.0 at the next breaking release. Hardcoded rather
         than derived from $(Version), which the release tag overrides. -->
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <!-- FileVersion would otherwise default to the pinned AssemblyVersion; track
         the real version so builds stay distinguishable. Skipped for prerelease
         values, which are not valid Win32 file versions. -->
    <FileVersion Condition="!$(Version.Contains('-'))">$(Version)</FileVersion>
    <Authors>clast-project</Authors>
    <Copyright>Copyright (c) clast-project</Copyright>
    <Description>Adaptive Lossless floating-Point (ALP) compression for arrays of double values. Designed for decimal-style data such as prices, sensor readings, and scientific measurements.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>compression;double;floating-point;alp;clast;serialization</PackageTags>
    <PackageProjectUrl>https://github.com/clast-project/alp</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/clast-project/alp</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Alp.Tests" Key="$(ClastPublicKey)" />
    <InternalsVisibleTo Include="Alp.Benchmarks" Key="$(ClastPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.14.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
